root = true

[*]
charset = utf-8
# .gitattributes の eol=lf と揃える
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.cs]
# --- APIDesign.md 3.5: 参照の null 判定は is null / is not null ---
# IDE0041 は ReferenceEquals(x, null) 形のみ対象。素の == null / != null は
# Roslynator RCS1248 (null チェックの正規化) で検出する。
dotnet_style_prefer_is_null_check_over_reference_equality_operator = true
dotnet_diagnostic.IDE0041.severity = warning
roslynator_null_check_style = pattern_matching
dotnet_diagnostic.RCS1248.severity = warning

# Roslynator は RCS1248 以外を目的に入れていないため、既定で有効な他ルールは無効化する
roslynator_analyzers.enabled_by_default = false

# --- APIDesign.md 10: public メンバーの XML ドキュメントコメント必須 ---
# CS1591 は GenerateDocumentationFile が有効なプロジェクト (src/) でのみ発火する
dotnet_diagnostic.CS1591.severity = warning

# --- コードスタイル (EnforceCodeStyleInBuild でビルド時に検査される) ---
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# --- StyleCop.Analyzers: opt-in ---
# Roslynator と同じ方針で、目的のあるカテゴリだけを有効にする。
# 個別ルールの指定は、カテゴリの指定より優先される。
# using の位置などの詳細設定は stylecop.json にある。

# 対象外のカテゴリ: 可読性 (SA11xx、this. の強制など)、保守性 (SA14xx)、特殊 (SA0xxx)
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none

# 対象のカテゴリ: 空白 (SA10xx)、並び順 (SA12xx)、命名 (SA13xx)、レイアウト (SA15xx)、ドキュメント (SA16xx)
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = warning
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = warning
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = warning
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = warning
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = warning

# 保守性のうち、1ファイル1型だけを有効にする
dotnet_diagnostic.SA1402.severity = warning

# private フィールドは FloatSoda と同じく _camelCase で書く
dotnet_diagnostic.SA1309.severity = none

# ドキュメントコメントの必須化は CS1591 が担当する (二重の指摘を避ける)
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none

# ファイルヘッダーは付けない。ライセンスは LICENSE とパッケージのメタデータで示す
dotnet_diagnostic.SA1633.severity = none

# ドキュメントコメントは日本語で書く。英語の定型文と句点 "." を求めるルールは対象外
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1624.severity = none
dotnet_diagnostic.SA1629.severity = none
dotnet_diagnostic.SA1642.severity = none
dotnet_diagnostic.SA1643.severity = none
